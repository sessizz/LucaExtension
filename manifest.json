{
  "manifest_version": 3,
  "name": "Luca Captcha, 2FA ve Firma Doldurucu",
  "version": "1.4",
  "description": "Luca captcha cozer, 2FA (Google Authenticator) kodunu uretir ve kayitli firma bilgilerini login alanlarina doldurur.",
  "icons": {
    "128": "assets/store-icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://agiris.luca.com.tr/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://agiris.luca.com.tr/*"],
      "all_frames": true,
      "js": ["totp.js", "providers.js", "content.js"]
    },
    {
      "matches": ["https://www.luca.com.tr/*", "https://luca.com.tr/*"],
      "js": ["luca-home.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
